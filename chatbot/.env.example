DB_URL=jdbc:postgresql://ep-example.region.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=replace-with-neon-password
PORT=8080
DB_DDL_AUTO=validate

# Groq: não registre chaves reais neste arquivo versionado.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Bot do Telegram
TELEGRAM_BOT_TOKEN=

# Recebimento do Telegram fica desligado por padrão; use uma única instância.
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_EMPRESA_ID=
TELEGRAM_CHATBOT_ID=
